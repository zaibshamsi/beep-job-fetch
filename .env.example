# ---------- Database (SQL Server) ----------
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=beepjobfetch
DB_USER=beepjob_app
DB_PASSWORD=change-me
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true

# ---------- Jev (TypeSafe AI) ----------
# TypeSafe key (console.typesafe.ai/keys, model jev-latest) or an OpenRouter key (sk-or-..., model typesafe/jev-1.14): the route is picked from the key
JEV_API_KEY=
JEV_MODEL=jev-latest

# ---------- LLM: Azure AI Foundry (OpenAI-compatible deployment) ----------
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# ---------- Job sources (all optional; a source without its key is skipped) ----------
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
CAREERJET_AFFID=
# Careerjet requires the public IP of the machine running the worker
CAREERJET_USER_IP=

# ---------- App ----------
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
# Contact shown in the crawler User-Agent so site owners can reach us
CRAWLER_CONTACT=https://github.com/zaibshamsi/beep-job-fetch
# Protects /settings and /pipeline/run if deployed (leave empty for local use)
ADMIN_TOKEN=
